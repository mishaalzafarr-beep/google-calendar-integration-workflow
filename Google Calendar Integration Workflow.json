    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\n\nconst errors = [];\n\n// Required fields\nif (!body.summary) {\n  errors.push(\"summary is required\");\n}\n\nif (!body.description) {\n  errors.push(\"description is required\");\n}\n\nif (!body.start) {\n  errors.push(\"start is required\");\n}\n\nif (!body.end) {\n  errors.push(\"end is required\");\n}\nif (!body.location) {\n   errors.push(\"location is required\");\n}\n\n// Summary length\nif (body.summary && body.summary.trim().length < 3) {\n  errors.push(\"summary must contain at least 3 characters\");\n}\n\n// Date validation\nconst startDate = Date.parse(body.start);\nconst endDate = Date.parse(body.end);\n\nif (body.start && isNaN(startDate)) {\n  errors.push(\"Invalid start date\");\n}\n\nif (body.end && isNaN(endDate)) {\n  errors.push(\"Invalid end date\");\n}\n\nif (!isNaN(startDate) && !isNaN(endDate) && startDate >= endDate) {\n  errors.push(\"End time must be after start time\");\n}\n\nreturn [\n  {\n    json: {\n      ...$json,\n      valid: errors.length === 0,\n      statusCode: errors.length ? 400 : 200,\n      message: errors.length\n        ? \"Validation failed\"\n        : \"Validation successful\",\n      validationErrors: errors\n    }\n  }\n];"
      },
